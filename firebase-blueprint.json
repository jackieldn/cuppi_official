{
  "entities": {
    "SupportRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Support Request",
      "type": "object",
      "description": "Represents a support request submitted through the contact form.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the person submitting the request."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address for contact."
        },
        "category": {
          "type": "string",
          "description": "The category of the support request."
        },
        "message": {
          "type": "string",
          "description": "The detailed support message from the user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the request was submitted."
        }
      },
      "required": [
        "name",
        "email",
        "category",
        "message",
        "createdAt"
      ]
    },
    "Project": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Project",
      "type": "object",
      "description": "Represents a project in the portfolio.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Project entity."
        },
        "title": {
          "type": "string",
          "description": "Title of the project."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the project."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the project's image.",
          "format": "uri"
        },
        "blurredImageUrl": {
          "type": "string",
          "description": "URL of a blurred version of the project's image, for use when the project is password protected.",
          "format": "uri"
        },
        "galleryImages": {
          "type": "array",
          "description": "An array of URLs for the project's gallery images.",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "videoUrls": {
          "type": "array",
          "description": "An array of URLs for the project's videos (if applicable).",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "featured": {
          "type": "boolean",
          "description": "Indicates whether the project is featured on the homepage."
        },
        "tags": {
          "type": "array",
          "description": "Tags to categorize the project",
          "items": {
            "type": "string"
          }
        },
        "deliveryDate": {
          "type": "string",
          "format": "date",
          "description": "The date the project was delivered."
        },
        "privacy": {
          "type": "object",
          "description": "Privacy settings for the project.",
          "properties": {
            "isPasswordProtected": {
              "type": "boolean",
              "description": "If true, the project requires a password to view."
            },
            "password": {
              "type": "string",
              "description": "The password for the project, if protected."
            }
          }
        },
        "noAi": {
          "type": "boolean",
          "description": "Flag to indicate if the project was made without Generative AI."
        },
        "aiDisclaimer": {
          "type": "string",
          "description": "An optional disclaimer about the use of AI in the project."
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "imageUrl",
        "featured"
      ]
    },
    "Snap": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Snap",
      "type": "object",
      "description": "Represents a single image in the Snaps gallery.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Snap."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the snap image.",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the snap was created."
        },
        "tags": {
          "type": "array",
          "description": "Categorization tags for the snap.",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "number",
          "description": "A number for manual sorting order."
        },
        "width": {
          "type": "number",
          "description": "The width of the image in pixels."
        },
        "height": {
          "type": "number",
          "description": "The height of the image in pixels."
        }
      },
      "required": [
        "id",
        "imageUrl",
        "createdAt",
        "width",
        "height"
      ]
    },
    "HobbyImage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Hobby Image",
      "type": "object",
      "description": "Represents a single image in the Free Time gallery.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Hobby Image."
        },
        "imageUrl": {
          "type": "string",
          "description": "URL of the hobby image.",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the image was created."
        },
        "tags": {
          "type": "array",
          "description": "Categorization tags for the image.",
          "items": {
            "type": "string"
          }
        },
        "order": {
          "type": "number",
          "description": "A number for manual sorting order."
        },
        "width": {
          "type": "number",
          "description": "The width of the image in pixels."
        },
        "height": {
          "type": "number",
          "description": "The height of the image in pixels."
        }
      },
      "required": [
        "id",
        "imageUrl",
        "createdAt",
        "width",
        "height"
      ]
    },
    "AboutProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "About Profile",
      "type": "object",
      "description": "Stores the main information for the About Me page.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "aboutText": { "type": "string" },
        "profilePictureUrl": { "type": "string", "format": "uri" },
        "cvUrl": { "type": "string", "format": "uri", "description": "Download URL of the uploaded CV (PDF). Optional: the Download CV button only shows when set." },
        "cvFileName": { "type": "string", "description": "The CV's original file name." }
      },
      "required": ["id", "name", "aboutText", "profilePictureUrl"]
    },
    "TechnicalSkill": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Technical Skill",
      "type": "object",
      "description": "Represents a single technical skill.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "number", "minimum": 1, "maximum": 5 },
        "iconUrl": { "type": "string", "format": "uri" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "level", "iconUrl"]
    },
    "WorkExperience": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Work Experience",
      "type": "object",
      "description": "Represents a single entry in the work experience timeline.",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "position": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "isCurrent": { "type": "boolean" },
        "description": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "order": { "type": "number" }
      },
      "required": ["id", "companyName", "position", "startDate"]
    },
    "Fact": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Fact",
      "type": "object",
      "description": "Represents a single fact for the About page.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "description"]
    },
    "Testimonial": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Testimonial",
      "type": "object",
      "description": "Represents a single testimonial for the About page.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "company": { "type": "string" },
        "text": { "type": "string" },
        "order": { "type": "number" },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date the testimonial was given."
        }
      },
      "required": ["id", "name", "text"]
    },
    "ChatbotKnowledge": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Chatbot Knowledge",
      "type": "object",
      "description": "Represents a single piece of knowledge for the AI chatbot.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "description": "The topic of this knowledge entry (e.g., About Me, Skills)." },
        "content": { "type": "string", "description": "The detailed information for the chatbot to use." }
      },
      "required": ["id", "title", "content"]
    },
    "App": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "App",
      "type": "object",
      "description": "An app or website shown on the portfolio's Apps & Websites page. The page body is an ordered list of sections (screenshot galleries and text-and-image blocks). Entries saved before the redesign (availability, galleryImages, no kind) are mapped onto this shape when read; see src/lib/showcase.ts.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "kind": { "type": "string", "enum": ["app", "website"] },
        "status": {
          "type": "string",
          "enum": ["live", "testflight", "decommissioned"],
          "description": "testflight is for apps only."
        },
        "tagline": { "type": "string", "description": "One line for the card, up to 140 characters." },
        "description": { "type": "string", "description": "Intro text; blank lines are paragraph breaks." },
        "tags": { "type": "array", "items": { "type": "string" } },
        "platforms": {
          "type": "array",
          "description": "Apps only.",
          "items": { "type": "string", "enum": ["iOS", "iPadOS", "macOS", "Android", "Windows"] }
        },
        "releaseDate": { "type": "string", "format": "date" },
        "decommissionedDate": { "type": "string", "format": "date", "description": "Only when status is decommissioned." },
        "link": { "type": "string", "format": "uri", "description": "App Store link, TestFlight invite or website address. Not shown once decommissioned." },
        "icon": { "$ref": "#/backend/entities/AppImage", "description": "App icon or site logo: the face of the card and of the page's top." },
        "iconColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Dominant colour of the icon, picked in the admin. Tints the backgrounds." },
        "order": { "type": "number", "description": "Position among entries of the same kind and status; lower first." },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["gallery", "feature"] },
              "title": { "type": "string" },
              "images": { "type": "array", "items": { "$ref": "#/backend/entities/AppImage" }, "description": "gallery only." },
              "body": { "type": "string", "description": "feature only." },
              "textSide": { "type": "string", "enum": ["left", "right"], "description": "feature only: which side the text sits on." },
              "image": { "$ref": "#/backend/entities/AppImage", "description": "feature only." }
            },
            "required": ["id", "type"]
          }
        }
      },
      "required": ["id", "title", "slug", "kind", "status", "releaseDate", "icon"]
    },
    "AppImage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "App Image",
      "type": "object",
      "description": "A screenshot, cover, icon or logo, with its pixel size so pages can lay it out before it loads.",
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "required": ["url", "width", "height"]
    },
    "LegalDocument": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Legal Document",
      "type": "object",
      "description": "Represents a legal document like Terms of Service or Privacy Policy.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["id", "title", "slug", "content"]
    },
    "role_admin": {
      "title": "Admin Role",
      "type": "object",
      "description": "A document indicating a user has admin privileges. The document itself can be empty.",
      "properties": {}
    },
    "BetaSignup": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Beta Signup",
      "type": "object",
      "description": "Represents an early access signup for the beta.",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "interestedFeatures": {
          "type": "array",
          "description": "A list of features the user is interested in.",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the signup was created."
        }
      },
      "required": [
        "email",
        "interestedFeatures",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/projects/{projectId}",
        "definition": {
          "entityName": "Project",
          "schema": {
            "$ref": "#/backend/entities/Project"
          },
          "description": "Collection of projects.",
          "params": [
            {
              "name": "projectId",
              "description": "Unique identifier for the project."
            }
          ]
        }
      },
      {
        "path": "/roles_admin/{userId}",
        "definition": {
          "entityName": "role_admin",
          "schema": {
            "$ref": "#/backend/entities/role_admin"
          },
          "description": "Documents in this collection represent admin users.",
          "params": [
            {
              "name": "userId",
              "description": "The Firebase UID of the admin user."
            }
          ]
        }
      },
      {
        "path": "/snaps/{snapId}",
        "definition": {
          "entityName": "Snap",
          "schema": {
            "$ref": "#/backend/entities/Snap"
          },
          "description": "Collection of snaps for the 'Best of Snaps' gallery.",
          "params": [
            {
              "name": "snapId",
              "description": "Unique identifier for the snap."
            }
          ]
        }
      },
      {
        "path": "/hobby_images/{hobbyImageId}",
        "definition": {
          "entityName": "HobbyImage",
          "schema": {
            "$ref": "#/backend/entities/HobbyImage"
          },
          "description": "Collection of images for the 'Free Time' gallery.",
          "params": [
            {
              "name": "hobbyImageId",
              "description": "Unique identifier for the hobby image."
            }
          ]
        }
      },
      {
        "path": "/music_covers/{coverId}",
        "definition": {
          "entityName": "MusicCover",
          "schema": {
            "type": "object",
            "description": "An album cover in the About page's Music taste section.",
            "properties": {
              "id": { "type": "string", "description": "Unique identifier for the cover." },
              "imageUrl": { "type": "string", "format": "uri", "description": "URL of the cover image (square)." },
              "title": { "type": "string", "description": "Optional album/artist label, used as alt text." },
              "order": { "type": "number", "description": "A number for manual sorting order." },
              "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the cover was added." }
            },
            "required": ["imageUrl", "order"]
          },
          "description": "Album covers for the About page's Music taste section.",
          "params": [{ "name": "coverId", "description": "Unique identifier for the cover." }]
        }
      },
      {
        "path": "/about_profile/{profileId}",
        "definition": {
          "entityName": "AboutProfile",
          "schema": { "$ref": "#/backend/entities/AboutProfile" },
          "description": "Stores the main profile information for the About page. Should only contain a single document.",
           "params": [{ "name": "profileId", "description": "Unique identifier for the profile document." }]
        }
      },
      {
        "path": "/technical_skills/{skillId}",
        "definition": {
          "entityName": "TechnicalSkill",
          "schema": { "$ref": "#/backend/entities/TechnicalSkill" },
          "description": "Collection of technical skills.",
           "params": [{ "name": "skillId", "description": "Unique identifier for the skill." }]
        }
      },
      {
        "path": "/work_experience/{experienceId}",
        "definition": {
          "entityName": "WorkExperience",
          "schema": { "$ref": "#/backend/entities/WorkExperience" },
          "description": "Collection of work experience entries.",
          "params": [{ "name": "experienceId", "description": "Unique identifier for the work experience." }]
        }
      },
      {
        "path": "/facts/{factId}",
        "definition": {
          "entityName": "Fact",
          "schema": { "$ref": "#/backend/entities/Fact" },
          "description": "Collection of facts for the About page.",
           "params": [{ "name": "factId", "description": "Unique identifier for the fact." }]
        }
      },
      {
        "path": "/testimonials/{testimonialId}",
        "definition": {
          "entityName": "Testimonial",
          "schema": { "$ref": "#/backend/entities/Testimonial" },
          "description": "Collection of testimonials for the About page.",
          "params": [{ "name": "testimonialId", "description": "Unique identifier for the testimonial." }]
        }
      },
      {
        "path": "/chatbot_knowledge/{knowledgeId}",
        "definition": {
          "entityName": "ChatbotKnowledge",
          "schema": { "$ref": "#/backend/entities/ChatbotKnowledge" },
          "description": "Collection of knowledge entries for the AI chatbot.",
          "params": [{ "name": "knowledgeId", "description": "Unique identifier for the knowledge entry." }]
        }
      },
      {
        "path": "/apps/{appId}",
        "definition": {
          "entityName": "App",
          "schema": { "$ref": "#/backend/entities/App" },
          "description": "Collection of apps and websites.",
          "params": [{ "name": "appId", "description": "Unique identifier for the app." }]
        }
      },
      {
        "path": "/legal_documents/{documentId}",
        "definition": {
          "entityName": "LegalDocument",
          "schema": { "$ref": "#/backend/entities/LegalDocument" },
          "description": "Stores legal documents like Terms of Service and Privacy Policy.",
          "params": [{ "name": "documentId", "description": "Unique identifier for the legal document." }]
        }
      },
      {
        "path": "/beta_signups/{signupId}",
        "definition": {
          "entityName": "BetaSignup",
          "schema": {
            "$ref": "#/backend/entities/BetaSignup"
          },
          "description": "Collection of beta signups.",
          "params": [
            {
              "name": "signupId",
              "description": "Unique identifier for the signup."
            }
          ]
        }
      }
    ]
  }
}
